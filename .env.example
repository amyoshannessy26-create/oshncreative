# Copy this file to .env.local for local dev, and add the same keys to
# Vercel → Project → Settings → Environment Variables for production.
# See SETUP.md for step-by-step instructions on obtaining each value.

# ---------- Database (Neon Postgres) ----------
# Pooled connection, used by the app at runtime. `pgbouncer=true` is required
# on Neon's pooled connection string — without it, writes (creating a lead,
# task, etc.) can fail with "prepared statement already exists" errors under
# serverless concurrency. See https://www.prisma.io/docs/orm/prisma-client/setup-and-configuration/databases-connections#pgbouncer
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
# Direct (unpooled) connection, used by Prisma Migrate.
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# ---------- Auth.js ----------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Only needed if deploying somewhere Auth.js can't infer the URL, e.g. preview deployments:
# AUTH_URL="https://your-app.vercel.app"

# ---------- Google OAuth (login) ----------
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------- Google Workspace integration (Drive + Calendar) ----------
# Can reuse the same OAuth client as above as long as the redirect URI below is
# also registered on it. Requires the Drive API and Calendar API enabled on the project.
GOOGLE_INTEGRATION_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"

# ---------- Xero OAuth 2.0 (PKCE) ----------
# https://developer.xero.com/app/manage — create a "Web app" integration.
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""
XERO_REDIRECT_URI="http://localhost:3000/api/integrations/xero/callback"

# ---------- Token encryption ----------
# AES-256-GCM key used to encrypt OAuth tokens at rest. Generate with:
# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""

# ---------- Cron ----------
# Shared secret checked on scheduled sync routes (Vercel Cron sends this as a
# Bearer token automatically when CRON_SECRET is set on the project).
CRON_SECRET=""
